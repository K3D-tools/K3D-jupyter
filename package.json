{
  "name": "k3d",
  "version": "3.0.0",
  "description": "3D visualization library",
  "keywords": [
    "jupyter",
    "widgets",
    "anywidget"
  ],
  "homepage": "https://github.com/K3D-tools/K3D-jupyter.git",
  "bugs": {
    "url": "https://github.com/K3D-tools/K3D-jupyter.git/issues"
  },
  "license": "MIT",
  "author": {
    "name": "k3d team",
    "email": "artur.trzesiok@gmail.com"
  },
  "files": [
    "js/src/**/*.{d.ts,eot,gif,html,jpg,js,js.map,json,png,svg,woff2,ttf}"
  ],
  "main": "js/src/standalone.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/K3D-tools/K3D-jupyter"
  },
  "scripts": {
    "build": "npm run install:js && npm run build:js",
    "build:prod": "npm run install:js && npm run build:js",
    "install:js": "cd js && npm install",
    "build:js": "cd js && npm run build",
    "prepare": "npm run build:prod",
    "prettier": "prettier --write \"**/*{.js,.jsx,.css,.json,.md}\""
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "file-saver": "^2.0.5",
    "katex": "^0.18.4",
    "lil-gui": "^0.21.0",
    "lodash": "^4.18.1",
    "@msgpack/msgpack": "^3.1.3",
    "rasterizehtml": "^1.4.1",
    "requirejs": "^2.3.8",
    "screenfull": "^6.0.2",
    "stats.js": "^0.17.0",
    "three": "^0.185.1",
    "three-mesh-bvh": "^0.9.14"
  },
  "devDependencies": {
    "prettier": "^2.6.2",
    "rimraf": "^3.0.2",
    "style-loader": "^3.3.1"
  }
}
